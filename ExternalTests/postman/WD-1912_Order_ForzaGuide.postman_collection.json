                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); const token = (j.data && j.data.token) || j.token;",
                  "pm.test('token presente', () => pm.expect(token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ],
          "response": []
        }
