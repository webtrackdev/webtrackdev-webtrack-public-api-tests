      "name": "2. createForzaGuide — flujo feliz",
      "item": [
        {
          "name": "A. Orden Odoo por orderNumber (sync de Odoo si no existe) + guía STD",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/createForzaGuide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "createForzaGuide"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": {\n    \"orderNumber\": \"{{odooOrderNumber}}\"\n  },\n  \"guide\": {\n    \"serviceType\": \"STD\",\n    \"recipient\": {\n      \"phone\": \"23456789\",\n      \"email\": \"recepcion@prueba.test\"\n    },\n    \"shipping\": {\n      \"townshipCode\": \"0101\"\n    },\n    \"packages\": {\n      \"count\": 1,\n      \"totalWeightKg\": 2.5,\n      \"declaredValue\": 150.0,\n      \"description\": \"Medicamentos\",\n      \"fragile\": true\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Si la orden no está en Reactive y la organización tiene Odoo habilitado, se busca la venta en Odoo, se importa (cliente/sucursal con las llaves odoo:<partner_id>) y se emite la guía."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('guía FD', () => pm.expect(pm.response.json().data.guide.trackingNumber).to.match(/^FD/));",
                  "const j = pm.response.json();",
                  "if (j.data && j.data.order) { pm.collectionVariables.set('orderId', j.data.order.orderId); }",
                  "if (j.data && j.data.guide) { pm.collectionVariables.set('guideId', j.data.guide.guideId); pm.collectionVariables.set('trackingNumber', j.data.guide.trackingNumber); }"
                ]
              }
            }
          ]
        },
